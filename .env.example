# Puerto del Servidor Node.js
PORT=3000

# Base de Datos MySQL / MariaDB (Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Google Identity Services (Google OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=

# Orígenes permitidos para solicitudes CORS (separados por comas)
APP_ORIGINS=https://somosgodmarket.com,https://www.somosgodmarket.com

# Credenciales de Cloudinary (Subida de fotos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secreto aleatorio de al menos 32 caracteres; nunca lo guardes en Git.
# Rota cualquier secreto anterior que haya estado en el repositorio; esto cierra las sesiones activas.
JWT_SECRET=

# Solo habilitar acceso demo en entornos locales/no productivos
ENABLE_DEMO_LOGIN=false
